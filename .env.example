# Copy this file to .env for local development.
# On Databricks Apps, the Lakebase URL is loaded from the
# database/lakebase-url secret (see app.yaml) — do not commit real secrets.

LAKEBASE_URL=postgresql://<role>:<password>@<your-lakebase-host>.database.cloud.databricks.com:5432/databricks_postgres?sslmode=require

LAKEBASE_SECRET_SCOPE=database
LAKEBASE_SECRET_KEY=lakebase-url

EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
WEATHER_DOCUMENTS_TABLE=weather_documents
WEATHER_EMBEDDINGS_TABLE=weather_embeddings
CHUNK_SIZE=800
CHUNK_OVERLAP=100
